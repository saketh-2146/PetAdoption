rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Anyone signed in can browse the pet catalogue; only signed-in users
    // can create listings, and only the owner (or an admin, wire up custom
    // claims for that) can edit/delete their own listing.
    match /pets/{petId} {
      allow read: if true;
      allow create: if request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'seller' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
      allow update, delete: if request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'seller' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );

      // Applications subcollection
      match /applications/{appId} {
        allow read: if request.auth != null && (
          resource.data.applicantUid == request.auth.uid || 
          get(/databases/$(database)/documents/pets/$(petId)).data.listedByUid == request.auth.uid
        );
        allow update, delete: if request.auth != null && resource.data.applicantUid == request.auth.uid;
        allow create: if request.auth != null && request.resource.data.applicantUid == request.auth.uid;
      }
    }

    // Allow collection group queries on 'applications' so users can fetch their orders
    match /{path=**}/applications/{appId} {
      allow read: if request.auth != null && (
        resource.data.applicantUid == request.auth.uid ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // Relaxed for admin dashboard
    match /users/{uid} {
      allow read, write: if request.auth != null;

      match /notifications/{notifId} {
        allow read, update, delete: if request.auth != null && request.auth.uid == uid;
        allow create: if request.auth != null;
      }
    }

    // Chats: only participants can read/write, and only the two people
    // already listed as participants can post messages.
    match /chats/{chatId} {
      allow read, update: if request.auth != null
        && request.auth.uid in resource.data.participantUids;
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.participantUids;

      match /messages/{messageId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantUids;
        allow create: if request.auth != null
          && request.resource.data.senderUid == request.auth.uid;
      }
    }
  }
}
